<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NxToWin</AssemblyName>
    <RootNamespace>NxToWin</RootNamespace>
    <Version>0.5.0</Version>
    <StartupObject>NxToWin.Bootstrap</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\drivers\hidapi.dll;..\..\drivers\WinUHid.dll;..\..\drivers\WinUHidDevs.dll" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\drivers\notices\*.txt" Link="Licenses\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <InternalsVisibleTo Include="NxToWin.ProtocolChecks" />
  </ItemGroup>

</Project>
